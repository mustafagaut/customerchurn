# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# Virtual environments
venv/
env/
.venv/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# IDE
.idea/
.vscode/
*.swp

# Model artifacts (large files)
models/*.joblib
models/*.pkl
models/*.pickle

# Data files (keep structure, ignore large files)
data/raw/*.csv
data/processed/*.csv
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# pytest cache
.pytest_cache/
.coverage
htmlcov/
